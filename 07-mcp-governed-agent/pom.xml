<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.datallmhub.cookbook</groupId>
        <artifactId>agentflow4j-cookbook-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>mcp-governed-agent</artifactId>
    <name>Recipe 07: Governed MCP agent</name>
    <description>Use the tools of an MCP server from an AgentGraph, with a ToolPolicy, a tool-call audit and lifecycle hooks.</description>

    <properties>
        <exec.mainClass>io.github.datallmhub.cookbook.mcp.McpGovernedAgentDemo</exec.mainClass>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.github.datallmhub.agentflow4j</groupId>
            <artifactId>agentflow4j-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.datallmhub.agentflow4j</groupId>
            <artifactId>agentflow4j-graph</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.datallmhub.agentflow4j</groupId>
            <artifactId>agentflow4j-squad</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-mcp</artifactId>
        </dependency>
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp-json-jackson2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <mainClass>${exec.mainClass}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
